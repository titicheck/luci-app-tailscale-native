#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
# Minimal OpenWrt procd adapter for a separately bootstrapped official Tailscale Core.

USE_PROCD=1
START=80

start_service() {
	local state_file port fw_mode out err

	[ -x /usr/sbin/tailscaled ] || return 1
	config_load tailscale
	config_get state_file settings state_file /etc/tailscale/tailscaled.state
	config_get port settings port 41641
	config_get fw_mode settings fw_mode nftables
	config_get_bool out settings log_stdout 1
	config_get_bool err settings log_stderr 1

	mkdir -p "$(dirname "$state_file")" /var/run/tailscale
	/usr/sbin/tailscaled --cleanup >/dev/null 2>&1 || true

	procd_open_instance
	procd_set_param command /usr/sbin/tailscaled --port "$port" --state "$state_file"
	procd_set_param env TS_DEBUG_FIREWALL_MODE="$fw_mode" TS_NO_LOGS_NO_SUPPORT=true
	procd_set_param respawn
	procd_set_param stdout "$out"
	procd_set_param stderr "$err"
	procd_close_instance
}

stop_service() {
	[ -x /usr/sbin/tailscaled ] && /usr/sbin/tailscaled --cleanup >/dev/null 2>&1 || true
}
