#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Fixed-scope Tailscale router performance policy for OpenWrt.
# No caller supplied interface, feature name or shell text is accepted.

ETHTOOL=/usr/sbin/ethtool
IP=/sbin/ip
[ -x "$IP" ] || IP=/usr/sbin/ip

route_dev() {
	[ -x "$IP" ] || return 1
	dev="$($IP -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -n1)"
	[ -n "$dev" ] || dev="$($IP route show default 2>/dev/null | awk '/^default/ { for (i=1;i<=NF;i++) if ($i=="dev" && (i+1)<=NF) { print $(i+1); exit } }')"
	[ -n "$dev" ] || return 1
	printf '%s\n' "$dev"
}

driver_name() {
	dev="$1"
	$ETHTOOL -i "$dev" 2>/dev/null | awk -F': ' '$1 == "driver" { print $2; exit }'
}

is_candidate_dev() {
	dev="$1"
	[ -e "/sys/class/net/$dev" ] || return 1
	# Bridge membership can include Docker/container veth peers. They are not the
	# physical forwarding NIC that Tailscale's UDP GRO recommendation targets.
	[ "$(driver_name "$dev")" = "veth" ] && return 1
	return 0
}

candidate_devs() {
	dev="$(route_dev)" || return 1
	if [ -d "/sys/class/net/$dev/brif" ]; then
		found=0
		for p in /sys/class/net/"$dev"/brif/*; do
			[ -e "$p" ] || continue
			member="$(basename "$p")"
			is_candidate_dev "$member" || continue
			printf '%s\n' "$member"
			found=1
		done
		[ "$found" -eq 1 ] && return 0
	fi
	is_candidate_dev "$dev" && printf '%s\n' "$dev"
}

feature_value() {
	dev="$1"
	name="$2"
	$ETHTOOL -k "$dev" 2>/dev/null | awk -F': ' -v n="$name" '$1 == n { sub(/ .*/, "", $2); print $2; exit }'
}

apply_one() {
	dev="$1"
	[ -e "/sys/class/net/$dev" ] || return 0
	features="$($ETHTOOL -k "$dev" 2>/dev/null)" || return 0
	printf '%s\n' "$features" | grep -q '^rx-udp-gro-forwarding:' || return 0
	printf '%s\n' "$features" | grep -q '^rx-gro-list:' || return 0
	$ETHTOOL -K "$dev" rx-udp-gro-forwarding on >/dev/null 2>&1 || true
	$ETHTOOL -K "$dev" rx-gro-list off >/dev/null 2>&1 || true
}

status_all() {
	[ -x "$ETHTOOL" ] || exit 0
	candidate_devs 2>/dev/null | while IFS= read -r dev; do
		[ -n "$dev" ] || continue
		udp="$(feature_value "$dev" rx-udp-gro-forwarding)"
		gro="$(feature_value "$dev" rx-gro-list)"
		[ -n "$udp" ] || continue
		[ -n "$gro" ] || continue
		printf '%s\t%s\t%s\n' "$dev" "$udp" "$gro"
	done
}

case "${1:-apply}" in
	apply)
		[ -x "$ETHTOOL" ] || exit 0
		candidate_devs 2>/dev/null | while IFS= read -r dev; do
			[ -n "$dev" ] && apply_one "$dev"
		done
		exit 0
		;;
	status)
		status_all
		exit 0
		;;
	*)
		exit 64
		;;
esac
